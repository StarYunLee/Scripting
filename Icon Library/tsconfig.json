{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "scripting": ["./types/device/scripting.d.ts"]
    },
    "lib": ["ES2022"],
    "strict": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "jsx": "preserve"
  },
  "include": ["./**/*.ts", "./**/*.tsx", "./types/device/*.d.ts"],
  "exclude": ["node_modules", "dist", "build"]
}
