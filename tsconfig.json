{
  "compilerOptions": {
    "target": "ESNext",
    "lib": [
      "ESNext"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "scripting": [
        "./dts/scripting.d.ts"
      ]
    },
    "allowJs": true,
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "react",
    "jsxFactory": "createElement",
    "jsxFragmentFactory": "Fragment"
  },
  "include": [
    "./dts/*.d.ts",
    "./**/*.ts",
    "./**/*.tsx"
  ],
  "exclude": [
    "./dts/scripting.d.ts",
    "node_modules",
    "dev",
    "tests",
    "build",
    "dist",
    "out"
  ]
}
